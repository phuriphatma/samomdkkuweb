# samo-claude-usage.env — for the Claude usage reporter (migration 0154).
#
# Install:  sudo cp server/samo-claude-usage.env.example /etc/samo-claude-usage.env
#           sudo chown root:root /etc/samo-claude-usage.env
#           sudo chmod 600 /etc/samo-claude-usage.env
#           sudo nano /etc/samo-claude-usage.env

# --- The Claude credential: set this ONE line and you are done ---------------
# Get it by running, on this server, ONCE:
#     claude setup-token
# Sign in as the SAMO Claude account; it prints a long-lived token. Paste it
# here. It does not rotate and does not need refreshing, so nothing has to be
# re-run on a schedule. If it ever expires the reporter posts to the same
# Discord channel telling you to issue a new one.
#
# NOTE this is NOT an sk-ant-… API key and one cannot be used instead: an API
# key authenticates the pay-per-token API, which has no 5-hour session window
# and no weekly cap. The windows this board books against exist only on the
# SUBSCRIPTION, so only a subscription credential can read them.
CLAUDE_OAUTH_TOKEN=

# Leave CLAUDE_OAUTH_TOKEN empty to fall back to `claude login` credentials in
# ~/.claude/.credentials.json, which the script then refreshes and re-saves
# itself (access ~2h, refresh ~12d and rotating).

# --- Supabase ---------------------------------------------------------------
VITE_SUPABASE_URL=https://fheueuowbchsnsvbcgil.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# An account that HOLDS the `claude` permission. The reporter signs in as an
# ordinary user and inserts under RLS — never service_role.
CLAUDE_REPORTER_EMAIL=
CLAUDE_REPORTER_PASSWORD=
