# samo-claude-usage.env — for the Claude usage reporter (migration 0154).
#
# Install:  sudo cp server/samo-claude-usage.env.example /etc/samo-claude-usage.env
#           sudo chown root:root /etc/samo-claude-usage.env
#           sudo chmod 600 /etc/samo-claude-usage.env
#           sudo nano /etc/samo-claude-usage.env

# --- The Claude credential -------------------------------------------------
# There is NO Claude token in this file, and there cannot be one.
#
# MEASURED 2026-08-16: a token from `claude setup-token` — the one advertised as
# valid for a year — is REFUSED by the usage endpoint:
#     HTTP 403 "OAuth token does not meet scope requirement user:profile"
# It carries user:inference but not user:profile, so it can spend the
# subscription and cannot read it. Backwards for a monitor.
#
# The credential comes from running, on this server, ONCE:
#     claude login
# as the SAMO Claude account. That writes ~/.claude/.credentials.json with the
# full scope set, and the reporter refreshes and re-saves it on every run (access
# ~2h, refresh ~12d and rotating), so a 15-minute timer renews it ~96 times a day
# and it never approaches expiry. If it ever does, the reporter says so in
# Discord rather than going quiet.
#
# NOTE an sk-ant-… API key cannot substitute either: it authenticates the
# pay-per-token API, which has no 5-hour session window and no weekly cap. The
# windows this board books against exist only on the SUBSCRIPTION.

# --- Supabase ---------------------------------------------------------------
VITE_SUPABASE_URL=https://fheueuowbchsnsvbcgil.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# An account that HOLDS the `claude` permission. The reporter signs in as an
# ordinary user and inserts under RLS — never service_role.
CLAUDE_REPORTER_EMAIL=
CLAUDE_REPORTER_PASSWORD=
