# Posts MEASURED Claude usage into the จองโควตา Claude board (migration 0154).
#
# Runs as `ubuntu` (the deploy user), NOT root: it reads that user's
# ~/.claude/.credentials.json, which is what `claude login` writes. Root has no
# such login and would find nothing.
#
# YOU LOG IN ONCE. The Claude credential is a user login, not an API key: the
# access token lives ~2h and the refresh token ~12 days AND ROTATES on use. The
# script refreshes on every run and saves the rotated pair, so running every
# 15 minutes renews the 12-day window ~96 times a day and it never expires.
# A re-login is needed only if this timer stops for 12 consecutive days — and
# if that happens the script says so in Discord rather than going quiet.
[Unit]
Description=Report Claude usage to the SAMO booking board
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/samo-projects/samomdkkuweb
# Supabase URL/key + the reporter account that holds the `claude` permission.
# chmod 600, root-owned, never in git. No Claude token here on purpose.
EnvironmentFile=/etc/samo-claude-usage.env
ExecStart=/usr/bin/node tools/claude-usage-report.mjs
