# Copy to /opt/vaultwarden/vaultwarden.env on the VM and fill in.
# NEVER commit the filled-in copy — it holds the admin token and SMTP password.
# chmod 600, owned by root.

# ── Address ──────────────────────────────────────────────────────────────
# MUST include the /vault/ subpath and MUST match what clients type.
# Vaultwarden derives its own route prefix from this; get it wrong and the
# web vault loads but every API call 404s.
DOMAIN=https://samo.md.kku.ac.th/vault/

# ── Who may create an account ────────────────────────────────────────────
# false = nobody can self-register. This is the whole access model: you
# invite people, they cannot walk in. Leave it false FOREVER.
SIGNUPS_ALLOWED=false
# Lets an org admin invite any address even with signups closed.
INVITATIONS_ALLOWED=true
# Belt and braces: even if SIGNUPS_ALLOWED is ever flipped true by accident,
# only kkumail addresses could register.
SIGNUPS_DOMAINS_WHITELIST=kkumail.com

# ── Admin panel at /vault/admin ──────────────────────────────────────────
# Generate the argon2 hash with:
#   docker run --rm -it vaultwarden/server:1.37.2-alpine /vaultwarden hash
# Paste the FULL string including the leading $argon2id$...
# It contains `$`. That is safe here because docker-compose uses env_file and
# passes these through literally — but if you ever move it into an inline
# `environment:` block in the YAML, every `$` must be doubled to `$$`.
ADMIN_TOKEN=

# ── Mail (invites, password hints, new-device codes) ─────────────────────
# The VM CANNOT be a mail server (25 blocked, no inbound) but CAN send through
# an authenticated relay on 587 — docs/EMAIL.md proves smtp-relay.brevo.com:587
# is reachable from this box. Create a free Brevo account and paste its SMTP
# key below.
#
# WITHOUT SMTP Vaultwarden still works, but every invite must be confirmed by
# hand in /vault/admin, and users cannot self-serve a new-device code. Set it
# up — the manual path is the thing that gets abandoned.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=samomdkku.ai@gmail.com
SMTP_FROM_NAME=SAMO Vault
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Hardening ────────────────────────────────────────────────────────────
# Don't leak whether an address has an account.
SHOW_PASSWORD_HINT=false
# Org creation is an admin act here, not a user one.
ORG_CREATION_USERS=admin
# Websocket for live sync + "log in with device". Whether KKU's edge forwards
# the Upgrade header is UNVERIFIED — if it strips it, clients fall back to
# polling and everything still works. Test after deploy; see skills/vaultwarden.md.
ENABLE_WEBSOCKET=true
# Icons are fetched from the sites you store. That means this VM makes outbound
# requests to arbitrary hosts derived from vault contents. Disable to keep the
# vault from touching the network on your users' behalf.
DISABLE_ICON_DOWNLOAD=true
# Login rate limiting (per second, burst).
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
# Log to a file inside /data so the backup captures it and journald stays clean.
LOG_LEVEL=warn
