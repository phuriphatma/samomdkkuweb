# Copy to /opt/vaultwarden/vaultwarden.env on the VM and fill in.
# NEVER commit the filled-in copy — it holds the admin token and SMTP password.
# chmod 600, owned by root.

# ── Address ──────────────────────────────────────────────────────────────
# MUST include the /vault/ subpath and MUST match what clients type.
# Vaultwarden derives its own route prefix from this; get it wrong and the
# web vault loads but every API call 404s.
DOMAIN=https://samo.md.kku.ac.th/vault/

# ── Who may create an account ────────────────────────────────────────────
# false = nobody can self-register. This is the whole access model: you
# invite people, they cannot walk in. Leave it false FOREVER.
SIGNUPS_ALLOWED=false
# Lets an org admin invite any address even with signups closed.
INVITATIONS_ALLOWED=true
# ⛔ DO NOT SET SIGNUPS_DOMAINS_WHITELIST. It does the OPPOSITE of what the name
# suggests. From src/config.rs:
#
#   pub fn is_signup_allowed(&self, email: &str) -> bool {
#       if self.signups_domains_whitelist().is_empty() {
#           self.signups_allowed()
#       } else {
#           // The whitelist setting overrides the signups_allowed setting.
#           self.is_email_domain_allowed(email)
#       }
#   }
#
# A NON-EMPTY whitelist means signups_allowed is NEVER CONSULTED. Setting it to
# "kkumail.com" as belt-and-braces did not narrow anything — it OPENED public
# registration to every one of KKU's ~40,000 kkumail accounts while
# SIGNUPS_ALLOWED=false sat there looking reassuring. Proven on 2026-09-06 by
# registering an uninvited account from the open internet; it returned 200.
#
# EMPTY whitelist + SIGNUPS_ALLOWED=false is the only closed configuration, and
# it also lets invitations reach ANY domain, because is_email_domain_allowed()
# returns true for everything when the whitelist is empty — which is how
# @gmail.com role accounts and @kku.ac.th staff get invited.
# SIGNUPS_DOMAINS_WHITELIST=

# ── Admin panel at /vault/admin ──────────────────────────────────────────
# Generate the argon2 hash with:
#   docker run --rm -it vaultwarden/server:1.37.2-alpine /vaultwarden hash
# Paste the FULL string including the leading $argon2id$...
# ⚠️ DOUBLE EVERY `$` — write `$$argon2id$$v=19$$m=...`, not `$argon2id$v=19$...`.
# Docker Compose v2 interpolates `$` in env_file values, so an unescaped hash
# arrives at the container mangled and Vaultwarden silently downgrades to
# treating it as a PLAIN TEXT token: the admin password then never works and the
# panel is guarded by a mangled string instead of a hash. Verify after writing:
#   docker exec vaultwarden printenv ADMIN_TOKEN | head -c 10    # -> $argon2id$
ADMIN_TOKEN=

# ── Mail (invites, password hints, new-device codes) ─────────────────────
# GOOGLE, not a transactional relay — decided 2026-09-05, and the reasoning
# matters because the obvious answer (Brevo, Resend, Mailjet) is WRONG here.
#
# DMARC constrains which address you send AS, not which machine sends
# (docs/EMAIL.md §3a). SAMO controls no domain's DNS: md.kku.ac.th belongs to
# KKU NOC and publishes p=reject inherited from kku.ac.th; gmail.com belongs to
# Google. So there is no domain we can add DKIM records to, and every
# third-party relay would send as @gmail.com with SPF and DKIM UNALIGNED.
# gmail.com publishes `p=none; sp=quarantine`, so that mail is not rejected
# outright — it is simply a strong spam signal, and the recipients here are
# @kkumail.com, which is Google Workspace. Google receiving Google-claiming
# mail from Brevo is the exact shape spam filters are built to catch.
#
# Relaying through Google AS the SAMO Gmail is aligned natively. Volume is not
# a factor either way: ~10 people generates tens of mails a MONTH against a
# 500/day limit.
#
# WHICH ACCOUNT: `mdstuddata.beta@gmail.com` — the succession ROLE account that
# already sends SAMO's official mail. `clasp` authenticates as it and Apps Script
# runs Execute-as-Me, so the หนังสือโครงการ MailApp mail goes out as studbeta
# today. Using it here keeps SAMO to ONE mail identity, and it is a role account
# so it does not graduate. (⚠️ docs/SUCCESSION.md's table credits Apps Script to
# samomdkku.ai — that row is wrong; verified 2026-09-05 from ~/.clasprc.json.)
#
# SETUP (owner, 2 min — an app password cannot be generated for you):
#   1. myaccount.google.com → Security → 2-Step Verification must be ON
#   2. → App passwords → name it "SAMO Vault" → copy the 16 characters
#   3. paste below WITHOUT spaces, then:
#      sudo docker compose -f /opt/vaultwarden/docker-compose.yml up -d
#
# An app password is not the account password: it authenticates SMTP/IMAP only,
# cannot pass the 2FA-protected web sign-in, and is revocable on its own. That
# is what keeps this from being "the vault holds the key to its own mailbox".
#
# WITHOUT it Vaultwarden still runs, but every invite must be confirmed by hand
# in /vault/admin and nobody can self-serve a new-device code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=mdstuddata.beta@gmail.com
SMTP_FROM_NAME=SAMO Vault
SMTP_USERNAME=mdstuddata.beta@gmail.com
SMTP_PASSWORD=

# ── Hardening ────────────────────────────────────────────────────────────
# Don't leak whether an address has an account.
SHOW_PASSWORD_HINT=false
# Who may CREATE an organization. Valid values are `all`, `none`, or a
# comma-separated list of EMAIL ADDRESSES — `admin` is not a value and
# Vaultwarden refuses to start with it (exit 12, "contains invalid email
# addresses"). Left at the default until the owner's account exists; then set
# it to that address so a member cannot spin up stray orgs:
#   ORG_CREATION_USERS=you@kkumail.com
# Websocket for live sync + "log in with device". Whether KKU's edge forwards
# the Upgrade header is UNVERIFIED — if it strips it, clients fall back to
# polling and everything still works. Test after deploy; see skills/vaultwarden.md.
ENABLE_WEBSOCKET=true
# Icons are fetched from the sites you store. That means this VM makes outbound
# requests to arbitrary hosts derived from vault contents. Disable to keep the
# vault from touching the network on your users' behalf.
DISABLE_ICON_DOWNLOAD=true
# Login rate limiting (per second, burst).
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
# Log to a file inside /data so the backup captures it and journald stays clean.
LOG_LEVEL=warn
