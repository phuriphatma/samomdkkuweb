[Unit]
Description=Run the Vaultwarden backup nightly

[Timer]
# ⚠️ OnCalendar, deliberately — NOT OnBootSec+OnUnitActiveSec.
# .claude/rules/mistakes.md class 7: a timer whose only triggers are monotonic
# comes back from a `disable` still reporting `enabled`/`active` with
# NextElapseUSecMonotonic=infinity — i.e. it looks scheduled and never fires.
# A wall-clock trigger always shows a real NEXT in `systemctl list-timers`,
# which is the only honest way to verify it.
OnCalendar=*-*-* 03:20:00
# Catch up after the VM has been off. Without this, a box that is down at 03:20
# simply skips that night and nothing says so.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
